{
  "expo": {
    "name": "CoreHa",
    "slug": "coreha-customer",
    "scheme": "coreha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.coreha.customer",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.coreha.customer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#17191d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CoreHa uses your photos to show our experts where new equipment will be installed.",
          "cameraPermission": "CoreHa uses the camera to photograph the space where new equipment will be installed."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17191d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1ccfd9",
          "defaultChannel": "critical-alerts"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b663ee21-ad47-4648-ba3c-e6509dedf9e3"
      }
    },
    "owner": "aleenjr10s-team"
  }
}
